# =============================================================================
# ADEO internal-cluster image: coro serving the speakrs diarization backend.
#
# Built FROM SCRATCH on the NVIDIA CUDA base — NOT layered on the public
# coro image — following the omnivoice-server internal-image layout
# (Dockerfile.internal in that repo), so the model weights are copied
# exactly once and the layer order keeps rebuilds cheap.
#
# ── LAYER ORDER (read before editing) ────────────────────────────────────────
# An instruction edit re-runs that step and EVERYTHING BELOW it, so layers
# are ordered rarest-change-first:
#   apt/deps/venv (lockfile edits only) -> speakrs weights (pinned-revision
#   bumps only) -> coro source (every commit) -> entrypoint/config.
#
#   1. NEVER `RUN chown -R` over a COPYed tree — it duplicates the whole tree
#      into a new layer (the omnivoice 4.9 GB lesson). Use `COPY --chown`.
#   2. The weights sit ABOVE the source COPY, NOT at the bottom: below it a
#      code edit would re-copy 31 MB of weights on every commit, while above
#      the deps sync a weights bump would re-sync the 8 GB venv — the slot
#      right after the deps sync is the only position where neither happens.
#
# Rebuild work per change:
#   coro source edit -> source COPY + project sync + wheel + Scalar (~30 s)
#   weights bump     -> two weights COPYs + the small source section
#   lockfile change  -> full rebuild including the 8 GB venv sync
#
# Reproduces the cluster-proven layout (omnivoice Dockerfile.internal):
#   * Ubuntu 24.04 + CUDA 12.8 runtime + cuDNN 9
#   * Python 3.12, venv at /home/runner/venv
#   * non-root user `runner` (UID/GID 10000)
#   * port 8080, GET /health-check returns 200 when ready
#   * all runtime writes under /tmp (read-only-root friendly)
#   * speakrs weights baked in (no HF download at first start)
#
# Build (from the repo root, or `make adeo` in docker/):
#   docker build -t coro:speakrs-adeo -f docker/Dockerfile.adeo .
#
# Run (read-only root filesystem friendly):
#   docker run --rm --gpus all -p 8080:8080 --user 10000:10000 \
#     --read-only --tmpfs /tmp:rw,size=8g coro:speakrs-adeo
# =============================================================================

ARG CUDA_BASE=nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04

# ---------------------------------------------------------------------------
# base — shared Python runtime layer for builder and runtime stages.
# ---------------------------------------------------------------------------
FROM ${CUDA_BASE} AS base

ARG PYTHON_VERSION=3.12

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

# NOTE on ASR device: the canary INT8 graph (static QDQ encoder + dynamic
# quint8 decoder) runs FASTER on the CPU EP than on the CUDA EP — quantized
# ops partition poorly across GPU/CPU with per-op tensor transfers — so the
# image deliberately does NOT put the venv's cu13 cuBLAS on LD_LIBRARY_PATH.
# A stress test on the RTX 4090 (8 x 5 concurrent 60s clips) measured:
#   CPU EP: 17x aggregate RTFx, p50 26.7s, 1007% container CPU
#   CUDA EP: 12x aggregate RTFx, p50 36.6s
# CORO_ASR_DEVICE=cpu pins the CPU EP deterministically (without it, 'auto'
# silently uses CUDA when the libs resolve, which is the slower path here).
# The GPU stays exclusively for speakrs diarization.

# Python 3.12 (deadsnakes, matching the public image's interpreter), ffmpeg
# for audio decoding, ca-certificates for the one-time model download below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        software-properties-common \
        ca-certificates \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION} \
        ffmpeg \
    && rm -f /usr/lib/python${PYTHON_VERSION}/EXTERNALLY-MANAGED \
    && apt-get purge -y software-properties-common \
    && apt-get autoremove -y \
    && ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python3 \
    && ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# runner — non-root user, UID/GID 10000 (REQ: "runner 10000 non root user").
# The venv is created and owned by this user, so site-packages need no
# root-owned files and the runtime user owns its interpreter.
# ---------------------------------------------------------------------------
RUN groupadd -g 10000 runner \
    && useradd -m -s /bin/bash -u 10000 -g 10000 runner \
    && usermod -aG video runner \
    && mkdir -p /home/runner/app /home/runner/models \
    && chown -R runner:runner /home/runner

# NOTE: PATH gets its own ENV instruction — keys in one ENV statement cannot
# reference variables set earlier in the SAME statement, so
# PATH="${VIRTUAL_ENV}/bin:$PATH" here would expand VIRTUAL_ENV to empty
# (the smoke-test "exec: coro: Is a directory" bug: bash fell through to the
# ./coro source directory in the workdir).
ENV VIRTUAL_ENV=/home/runner/venv \
    HOME=/tmp/runner \
    TMPDIR=/tmp/runner/tmp
ENV PATH="${VIRTUAL_ENV}/bin:$PATH"

# Drop to UID 10000 for everything that writes under /home/runner.
USER runner

# uv cache home (podman note: --mount=type=cache targets are created
# root-owned, which broke the runner-user sync steps; so the cache lives in
# the runner-owned home instead of a cache mount, and is deleted in the last
# build step to keep the image slim).
ENV UV_CACHE_DIR=/home/runner/.cache/uv
RUN mkdir -p /home/runner/.cache/uv

WORKDIR /home/runner/app

# ---------------------------------------------------------------------------
# builder-ish layer: resolve the venv as `runner` (single stage is fine here:
# the venv lives under /home/runner and needs no stripping).
# ---------------------------------------------------------------------------
ARG CORO_VERSION=0.0.0
ARG EXTRA=cuda
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${CORO_VERSION} \
    HATCH_VCS_PRETEND_VERSION=${CORO_VERSION} \
    UV_PYTHON_PREFERENCE=system \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/home/runner/venv

# uv binary, copied root-owned but world-readable/executable.
COPY --from=ghcr.io/astral-sh/uv:0.11.12 --chown=runner:runner /uv /uvx /bin/

# Resolve dependencies first (cached): lock + metadata only, then the project.
COPY --chown=runner:runner pyproject.toml uv.lock README.md LICENSE ./

RUN uv sync --frozen --no-install-project --no-dev --no-editable \
        --no-install-package triton --extra ${EXTRA}

# ---------------------------------------------------------------------------
# Baked speakrs weights (docker/models/speakrs/, gitignored — populate from
# the HF cache after a local run; see make fetch-models).
#
# Positioned ABOVE the coro source COPY, right after the deps sync: weights
# change only when the pinned revision moves, source changes with every
# commit, and an edit re-runs everything below it — so weights below source
# would re-copy 31 MB per code edit, while weights above the deps sync would
# re-sync the 8 GB venv per weights bump. This is the only slot avoiding both.
#
# The 9 files the speakrs CUDA modes load, in the pinned-revision snapshot
# layout: the HF cache stores blobs + a snapshot dir of symlinks, so export
# with `cp -L` (dereference) before building. Split into two layers — the
# ~31 MB model blobs and the tiny PLDA/text aux files — so swapping one
# never re-copies the other.
# ---------------------------------------------------------------------------
ARG SPEAKRS_MODEL_DIR=docker/models/speakrs
# Model blobs (~31 MB, stable): segmentation + speaker embedding weights.
COPY --chown=runner:runner ${SPEAKRS_MODEL_DIR}/segmentation-3.0.safetensors \
     ${SPEAKRS_MODEL_DIR}/wespeaker-multimask-tail.safetensors \
     /home/runner/models/speakrs/
# Aux files (PLDA matrices + min-samples text): kilobytes, separate layer.
COPY --chown=runner:runner ${SPEAKRS_MODEL_DIR}/wespeaker-voxceleb-resnet34.min_num_samples.txt \
     ${SPEAKRS_MODEL_DIR}/plda_lda.npy \
     ${SPEAKRS_MODEL_DIR}/plda_tr.npy \
     ${SPEAKRS_MODEL_DIR}/plda_mu.npy \
     ${SPEAKRS_MODEL_DIR}/plda_psi.npy \
     ${SPEAKRS_MODEL_DIR}/plda_mean1.npy \
     ${SPEAKRS_MODEL_DIR}/plda_mean2.npy \
     /home/runner/models/speakrs/

# ---------------------------------------------------------------------------
# Baked canary ASR model (docker/models/canary/, gitignored — populate with
# `make fetch-models`; the full snapshot layout so the standard HF-hub cache
# resolution finds it offline). The default ASR slug
# (onnx-canary-split / collectiveai/canary-1b-v2-onnx-split-int8, ~1.3 GB
# quantized) — resolved with huggingface_hub.snapshot_download, which under
# HF_HUB_OFFLINE=1 needs the snapshot dir AND refs/main under HF_HUB_CACHE.
# The entrypoint seeds the cache from this layer at start.
#
# Same layer-order slot as the speakrs weights: above the source COPY (a
# code edit must not re-copy 1.3 GB), below the deps sync (a model bump must
# not re-sync the 8 GB venv). Blobs + refs split into two layers so a
# revision bump never re-copies the other.
# ---------------------------------------------------------------------------
ARG CANARY_MODEL_DIR=docker/models/canary
# Two COPYs (not one with both sources): multiple sources flatten into the
# dest, which would lose the snapshots/<rev>/ nesting that snapshot_download
# resolves. Copy the parent dir to preserve the tree.
COPY --chown=runner:runner ${CANARY_MODEL_DIR}/snapshots /home/runner/models/canary/snapshots
COPY --chown=runner:runner ${CANARY_MODEL_DIR}/refs /home/runner/models/canary/refs

# Optional speakrs wheel (docker/wheels/, gitignored; maturin build from
# avencera/speakrs), also above the source COPY: like the weights it is a
# rare-change binary blob (only a speakrs version bump touches it), so a
# code edit must not re-copy it. The project sync below uses --inexact so it
# installs coro WITHOUT pruning speakrs — which is not in the lockfile
# (it is not on PyPI; see docs/adr/0025). --no-deps: the CUDA libraries its
# extras would pull already resolve from the venv (torch cu13 cuDNN via
# LD_LIBRARY_PATH, nvidia-cublas-cu12 from the cuda extra). A missing wheel
# keeps the build working; the backend names the install steps at startup
# if selected. The default matches the maturin output (manylinux_2_35 abi3);
# the Makefile passes the staged wheel explicitly via --build-arg.
# Copy into a directory, NOT a renamed file: uv validates wheel filenames
# (needs the python/abi/platform tags), so the original maturin name must
# survive the COPY. Same pattern as the public docker/Dockerfile.
ARG SPEAKRS_WHEEL=docker/wheels/speakrs-0.7.0-cp311-abi3-manylinux_2_35_x86_64.whl
COPY --chown=runner:runner ${SPEAKRS_WHEEL} /tmp/speakrs-wheel/
RUN uv pip install --python ${VIRTUAL_ENV}/bin/python --no-deps /tmp/speakrs-wheel/*.whl \
    && rm -rf /tmp/speakrs-wheel

COPY --chown=runner:runner coro ./coro

RUN uv sync --frozen --no-dev --no-editable --inexact \
        --no-install-package triton --extra ${EXTRA}

# Self-host the Scalar docs bundle (same as the public image), then drop the
# uv cache so the shipped layers carry only the venv. Runs after the source
# COPY because it imports coro.api.docs for the pinned URL.
RUN ${VIRTUAL_ENV}/bin/python -c "\
import urllib.request; \
from coro.api.docs import SCALAR_CDN_URL, bundle_path; \
target = bundle_path(); \
target.parent.mkdir(parents=True, exist_ok=True); \
urllib.request.urlretrieve(SCALAR_CDN_URL, target); \
print('scalar bundle', target, target.stat().st_size, 'bytes')" \
    && rm -rf /home/runner/.cache

# ══════════════════════════════════════════════════════════════════════════
# VOLATILE LAYERS BELOW — entrypoint, config.
# ══════════════════════════════════════════════════════════════════════════

# ---------------------------------------------------------------------------
# Entrypoint: /tmp redirection (read-only-root friendly), baked-weights
# seeding, then exec coro as PID 1.
# ---------------------------------------------------------------------------
COPY --chown=runner:runner --chmod=755 docker/entrypoint-adeo.sh /usr/local/bin/entrypoint.sh

# ---------------------------------------------------------------------------
# Runtime configuration. HF_HUB_OFFLINE=1: everything is baked in; a surprise
# network fetch at start is a deployment error, not a convenience.
# ---------------------------------------------------------------------------
ENV CORO_BACKEND_DIARIZATION=speakrs \
    CORO_DIARIZATION_SPEAKRS_MODE=cuda-fast \
    CORO_DIARIZATION_WORKERS=4 \
    CORO_MODEL_DIARIZATION=pyannote/speaker-diarization-community-1 \
    CORO_PYANNOTE_DIARIZE_MODEL_ID=pyannote/community-1 \
    CORO_ASR_DEVICE=cpu \
    HF_HUB_OFFLINE=1 \
    SPEAKRS_MODEL_DIR=/home/runner/models/speakrs \
    XDG_CACHE_HOME=/tmp/runner/.cache \
    HF_HOME=/tmp/runner/hf \
    HF_HUB_CACHE=/tmp/runner/hf/hub

# Port 8080 (REQ).
EXPOSE 8080

# HEALTHCHECK probes the /health-check alias; 200 only when the diarization
# adapter is loaded (coro's /health reports capability readiness).
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health-check')" || exit 1

# Run as UID 10000 (restated so the intent is obvious).
USER runner

# Single foreground process; the entrypoint exec's coro serve as PID 1.
# Absolute path: exec must not depend on PATH lookup (the earlier PATH bug
# made bash resolve `coro` to the ./coro source directory and die with EISDIR).
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/home/runner/venv/bin/coro", "serve", "--port", "8080"]
